[
  {
    "id": "printf-fixed-precision",
    "prompt": "怎样用 `printf` 把 `double value` 输出为小数点后两位？",
    "options": [
      { "id": "a", "text": "`printf(\"%.2f\\n\", value);`" },
      { "id": "b", "text": "`printf(\"%2d\\n\", value);`" },
