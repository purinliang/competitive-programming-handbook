[
  {
    "id": "pointer-declaration",
    "prompt": "`int* p = &x;` 表示什么？",
    "options": [
      { "id": "a", "text": "`p` 是指向 `int` 的指针，保存 `x` 的地址" },
      { "id": "b", "text": "`p` 是 `x` 的整数副本" },
      { "id": "c", "text": "`p` 是含有 `x` 个元素的数组" },
      { "id": "d", "text": "`p` 会把 `x` 删除" }
    ],
    "correctOptionId": "a",
    "explanation": "`int*` 是指针类型，`&x` 取得 `x` 的地址并用它初始化 `p`。"
  },
  {
    "id": "dereference",
    "prompt": "若 `p` 指向 `x`，表达式 `*p` 表示什么？",
    "options": [
      { "id": "a", "text": "指针自己的地址" },
      { "id": "b", "text": "`p` 指向的原对象 `x`" },
      { "id": "c", "text": "一个与 `x` 无关的新整数" },
      { "id": "d", "text": "数组容量" }
    ],
    "correctOptionId": "b",
    "explanation": "解引用通过指针保存的地址访问目标对象，因此给 `*p` 赋值就是修改 `x`。"
  },
  {
    "id": "change-pointee",
    "prompt": "执行 `p = &b;` 时改变的是什么？",
    "options": [
      { "id": "a", "text": "把 `b` 改成空指针" },
      { "id": "b", "text": "把原对象和 `b` 自动交换" },
      { "id": "c", "text": "`p` 保存的地址，使它改为指向 `b`" },
      { "id": "d", "text": "把指针类型改成 `double*`" }
    ],
    "correctOptionId": "c",
    "explanation": "普通指针变量可以保存另一个同类型对象的地址，从而改变目标。"
  },
  {
    "id": "null-pointer",
    "prompt": "关于 `nullptr`，下面哪项正确？",
    "options": [
      { "id": "a", "text": "它表示数组末尾的最后一个元素" },
      { "id": "b", "text": "它是一个可以读写的整数对象" },
      { "id": "c", "text": "解引用它一定得到 `0`" },
      { "id": "d", "text": "它明确表示指针当前没有指向对象，不能解引用" }
    ],
    "correctOptionId": "d",
    "explanation": "空指针可用于表示缺少目标和进行比较，但不指向可访问对象。"
  },
  {
    "id": "array-pointer-step",
    "prompt": "若 `p` 指向 `int` 数组元素，`p + 1` 向后移动多少？",
    "options": [
      { "id": "a", "text": "一个 `int` 元素的位置" },
      { "id": "b", "text": "固定一个比特" },
      { "id": "c", "text": "整个数组的长度" },
      { "id": "d", "text": "回到数组开头" }
    ],
    "correctOptionId": "a",
    "explanation": "指针算术以所指类型的元素为单位，不需要手动乘 `sizeof(int)`。"
  },
  {
    "id": "pointer-versus-value-increment",
    "prompt": "`p++` 与 `(*p)++` 的区别是什么？",
    "options": [
      { "id": "a", "text": "两者都只增加指针地址" },
      { "id": "b", "text": "前者移动指针，后者增加当前指向的整数" },
      { "id": "c", "text": "两者都只修改整数" },
      { "id": "d", "text": "两者都不能用于数组" }
    ],
    "correctOptionId": "b",
    "explanation": "括号让解引用先发生，因此自增作用于目标对象；没有括号时后缀自增作用于指针。"
  },
  {
    "id": "one-past-end",
    "prompt": "指向数组末尾后一位的指针可以怎样使用？",
    "options": [
      { "id": "a", "text": "只能改成字符指针" },
      { "id": "b", "text": "可以当作一个额外数组元素读写" },
      { "id": "c", "text": "可以作为比较边界，但不能解引用" },
      { "id": "d", "text": "必须保存答案" }
    ],
    "correctOptionId": "c",
    "explanation": "C++ 允许形成末尾后一位的边界指针，但那个位置不属于数组元素。"
  },
  {
    "id": "scanf-address",
    "prompt": "`scanf(\"%d\", &x)` 为什么传入 `&x`？",
    "options": [
