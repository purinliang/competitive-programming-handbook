{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "competitive-programming-handbook",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/content/*",
      "/catalog/*/*",
      "/learning-path/*/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handbook-learning",
      "database_id": "b7c18c04-76ec-49fc-857b-33d9a3eded25",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "handbook-content"
    }
  ]
}
